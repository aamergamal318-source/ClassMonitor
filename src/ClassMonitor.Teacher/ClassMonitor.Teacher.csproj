<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClassMonitorTeacher</AssemblyName>
    <RootNamespace>ClassMonitor.Teacher</RootNamespace>
    <ApplicationIcon>..\..\branding\classmonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassMonitor.Shared\ClassMonitor.Shared.csproj" />
    <InternalsVisibleTo Include="ScreenStreaming" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\branding\logo.png" LogicalName="logo.png" />
  </ItemGroup>

</Project>
