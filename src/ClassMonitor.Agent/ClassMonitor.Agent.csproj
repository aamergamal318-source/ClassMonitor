<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClassMonitorAgent</AssemblyName>
    <RootNamespace>ClassMonitor.Agent</RootNamespace>
    <ApplicationIcon>..\..\branding\classmonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassMonitor.Shared\ClassMonitor.Shared.csproj" />
    <Compile Include="../ClassMonitor.Desktop/UpdateController.cs" Link="UpdateController.cs" />
    <InternalsVisibleTo Include="ScreenStreaming" />
  </ItemGroup>

</Project>
